# Sync Server URL
VITE_SYNC_SERVER_URL=http://localhost:4000

# For mobile pairing, use your local IP:
# VITE_SYNC_SERVER_URL=http://192.168.1.100:4000

# Optional: enable AI planning (Gemini). Create a local .env or set this value in your shell.
# Get an API key from Google Cloud (Generative AI / API Key) and set it here.
# VITE_GEMINI_API_KEY=your_api_key_here
